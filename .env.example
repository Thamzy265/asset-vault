# Copy to .env and fill in every empty value. .env is git-ignored.

# Postgres. Set a long random password, letters and digits only: it is placed in a URL.
# Docker Compose refuses to start while it is empty.
POSTGRES_USER=vault
POSTGRES_DB=vault
POSTGRES_PASSWORD=

# Host port for the web app (bound to 127.0.0.1 only).
WEB_PORT=3000
