# Copy to .env and fill in every empty value. .env is git-ignored.

# Postgres. Set a long random password, letters and digits only: it is placed in a URL.
# Docker Compose refuses to start while it is empty.
POSTGRES_USER=vault
POSTGRES_DB=vault
POSTGRES_PASSWORD=

# Logins for the app (design note M1.2, decision 3): vault_migrator runs the
# migrations, vault_app is what web and worker use. Same rules as above: long,
# random, letters and digits only, all three different. Set before the first
# start: Postgres creates the roles from them on an empty volume (README,
# "Database roles", says how to change them later).
VAULT_MIGRATOR_PASSWORD=
VAULT_APP_PASSWORD=

# Host port for the web app (bound to 127.0.0.1 only).
WEB_PORT=3000

# Sign-in (M1.3). AUTH_ENCRYPTION_KEY encrypts the authenticator secrets, keys the
# backup-code hashes and signs the sign-in cookies. Long and random, for example
# `openssl rand -hex 32`. Docker Compose refuses to start while it is empty. Changing
# it later signs everyone out and makes every authenticator unusable (each person
# then needs a new setup link from pnpm user:create).
AUTH_ENCRYPTION_KEY=

# The address people open the app at. Defaults to http://127.0.0.1:WEB_PORT.
# APP_URL=https://vault.example.org

# Behind a proxy that sets the client IP in one header and overwrites any client
# value (Cloudflare: cf-connecting-ip, M1.4). Empty by default: the IP is unknown.
# X-Forwarded-For is never trusted.
AUTH_TRUSTED_IP_HEADER=
