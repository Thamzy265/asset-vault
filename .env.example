# Copy to .env and fill in every empty value. .env is git-ignored.

# Postgres. Set a long random password, letters and digits only: it is placed in a URL.
# Docker Compose refuses to start while it is empty.
POSTGRES_USER=vault
POSTGRES_DB=vault
POSTGRES_PASSWORD=

# Logins for the app (design note M1.2, decision 3): vault_migrator runs the
# migrations, vault_app is what web and worker use. Same rules as above: long,
# random, letters and digits only, all three different. Set before the first
# start: Postgres creates the roles from them on an empty volume (README,
# "Database roles", says how to change them later).
VAULT_MIGRATOR_PASSWORD=
VAULT_APP_PASSWORD=

# Host port for the web app (bound to 127.0.0.1 only).
WEB_PORT=3000
