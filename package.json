{
  "name": "asset-vault",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tsconfig.json",
    "test": "vitest run",
    "secrets": "secretlint \"**/*\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm secrets",
    "test:e2e": "playwright test",
    "deps:audit": "pnpm audit --prod --audit-level=moderate",
    "db:migrate": "docker compose run --rm --no-deps migrate",
    "db:rollback": "docker compose run --rm --no-deps migrate node packages/db/src/cli.ts down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "1.64.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "secretlint": "^14.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
